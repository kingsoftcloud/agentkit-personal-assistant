{
  "name": "@kingsoftcloud/agentkit-personal-assistant",
  "version": "0.1.16",
  "description": "Standalone personal assistant DSH plugin with multi-Bot profiles and an explicit Cloud Computer Broker boundary.",
  "homepage": "https://github.com/kingsoftcloud/agentkit-personal-assistant",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingsoftcloud/agentkit-personal-assistant.git"
  },
  "bugs": {
    "url": "https://github.com/kingsoftcloud/agentkit-personal-assistant/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.23.4 || >=24.22.1",
    "dsh": "0.2.2-rc.1"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./dist/client.js",
    "./manifest": "./personal-assistant.plugin.json",
    "./bot-registry": "./src/bot-registry.mjs",
    "./computer-broker": "./src/computer-broker.mjs",
    "./computer-broker-protocol": "./src/computer-broker-protocol.mjs",
    "./plugin-manifest": "./src/plugin-manifest.mjs",
    "./cloud-computer-tools": "./src/cloud-computer-tools.mjs",
    "./schedule-manager": "./src/schedule-manager.mjs",
    "./persistent-state": "./src/persistent-state.mjs",
    "./workspace": "./src/workspace.mjs",
    "./implementation-capabilities": "./src/implementation-capabilities.mjs",
    "./dsh-session-bridge": "./src/dsh-session-bridge.mjs"
  },
  "files": [
    "src",
    "runtime",
    "web",
    "scripts",
    "personal-assistant.plugin.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "personal-assistant.plugin.schema.json",
    "dist/client.js"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "pack:check": "npm pack --dry-run",
    "build:artifacts": "node scripts/build-artifacts.mjs",
    "build:client": "node scripts/build-client.mjs",
    "dev:client": "node scripts/build-client.mjs --watch",
    "prepack": "npm run build:client",
    "publish:check": "node --check src/index.mjs && npm test && npm pack --dry-run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "external": [
        "@deepseek-ai/dsh-client-connection"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "main": "./src/index.mjs",
  "devDependencies": {
    "esbuild": "0.27.7"
  },
  "dependencies": {
    "yaml": "2.8.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "dsh-plugin",
    "agentkit",
    "personal-assistant",
    "cloud-computer"
  ]
}
