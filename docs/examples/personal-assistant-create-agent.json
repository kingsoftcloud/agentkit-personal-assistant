{
  "Name": "pa-replay-template",
  "Description": "个人助理 DSH 与云电脑预发验收",
  "Framework": "personal-assistant",
  "Region": "cn-beijing-6",
  "DeploymentType": "ManagedRuntime",
  "ManagedRuntimeConfig": {
    "RuntimeName": "personal-assistant",
    "RuntimeVersion": "0.1.2",
    "Manifest": "name: pa-replay-template\nframework: personal-assistant\nartifact_type: ManagedRuntime\nruntime:\n  name: personal-assistant\n  version: \"0.1.2\"\nmodel: \"glm-5.1\"\nprompt: 请用中文完成用户任务。\n"
  },
  "Resource": { "Cpu": 1, "Memory": 4 },
  "Scaling": { "MinReplicas": 1, "MaxReplicas": 1 },
  "Storage": { "MountPath": "/data", "SizeGi": 20 },
  "Network": { "EnablePublicAccess": true, "EnableVpcAccess": false },
  "Advanced": {
    "EnableObservability": false,
    "EnvironmentVariables": [
      { "Key": "OPENAI_BASE_URL", "Value": "https://kspmas.ksyun.com/v1" }
    ]
  },
  "InstanceId": "<NEW_INSTANCE_UUID>"
}
